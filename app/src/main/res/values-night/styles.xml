<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoOptimiser" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_mint_light</item>
        <item name="android:navigationBarColor">#0D1E25</item>
        <item name="android:statusBarColor">#0D1E25</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.AutoOptimiser.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D1E25</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.AutoOptimiser</item>
    </style>
</resources>
