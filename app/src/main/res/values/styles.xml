<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoOptimiser" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_mint</item>
        <item name="android:navigationBarColor">@color/brand_sand</item>
        <item name="android:statusBarColor">@color/brand_sand</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.AutoOptimiser.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_sand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.AutoOptimiser</item>
    </style>
</resources>
